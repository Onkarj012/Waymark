# Waymark — Go server + CLI environment variables.
# Copy to .env and fill in real values (.env is gitignored). Never commit
# real secrets. Full reference, including the Cloudflare Workers deployment
# path, lives in docs/self-hosting/ENV.md.

# --- Go server (cmd/server) ---------------------------------------------

# REQUIRED. Owner secret for the browser admin sign-in (device authorization
# approval, admin UI). Generate with: openssl rand -base64 48
WAYMARK_ADMIN_PASSCODE=change-me-to-a-long-random-secret

# REQUIRED. Public origin that serves published pages, e.g. https://pages.example.com
PUBLIC_BASE_URL=http://pages.localhost:8080

# REQUIRED. Control origin that serves the API and admin UI. Must be a
# different origin than PUBLIC_BASE_URL, e.g. https://control.example.com
CONTROL_BASE_URL=http://control.localhost:8080

# Optional. Device API token lifetime in days (range 1..365, default 90).
WAYMARK_TOKEN_TTL_DAYS=90

# Optional. Path to the SQLite database file. On Railway, point this at the
# mounted volume.
DB_PATH=./waymark.db

# Optional. TCP port the HTTP server listens on (Railway sets this
# automatically).
PORT=8080

# Optional. Presence of any non-empty value makes the server trust
# X-Forwarded-For/X-Real-IP for rate-limit keying — needed on platforms like
# Railway that terminate TLS in front of the app. Leave unset for a bare
# VM/container deployment with no trusted reverse proxy in front.
RAILWAY_ENVIRONMENT_ID=

# --- waymark CLI (cmd/waymark) ------------------------------------------

# Optional. Overrides the saved server URL from `waymark login`.
WAYMARK_URL=http://control.localhost:8080

# Optional. Overrides the saved device API token from `waymark login`.
WAYMARK_TOKEN=

# Optional. Directory holding the CLI's config.json (login state). Defaults
# to $XDG_CONFIG_HOME/waymark, falling back to ~/.config/waymark.
WAYMARK_CONFIG_DIR=

# Optional. Standard XDG base-directory var; only consulted if
# WAYMARK_CONFIG_DIR is unset.
XDG_CONFIG_HOME=
